# ===== Backend =====
# Replaceable LLM adapter. Both safety intent and answer generation use OpenRouter here.
LLM_PROVIDER=openrouter
# Model name consumed by the selected adapter. For Ollama this is your local fine-tuned model tag.
LLM_MODEL_NAME=gemma-finetuned:4-bit
# Optional model endpoint override. Ollama uses http://localhost:11434/v1 by default.
LLM_BASE_URL=
# Optional single provider key. Prefer a local secret file; never commit a real key.
LLM_API_KEY=
# Request bounds for any remote/local HTTP-compatible adapter.
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1000
# Retry count for remote adapters. Local CPU generation gets its own (below).
LLM_MAX_RETRIES=3
# Optional role-specific overrides; leave blank to use LLM_MODEL_NAME for both stages.
INTENT_MODEL_NAME=
GENERATION_MODEL_NAME=

# Ollama server URL (default local install)
OLLAMA_BASE_URL=http://localhost:11434
# Name of the fine-tuned model loaded in Ollama
OLLAMA_MODEL_NAME=gemma-finetuned:4-bit
# OpenAI-compatible endpoint used by the KrishokChat model-selector option.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11435/v1
# Exact model ID exposed by the local server.
LOCAL_LLM_MODEL_NAME=krishokchat-4b
# --- Local (CPU) model tuning: CPU inference at ~5 tok/s needs far more
# --- headroom than remote APIs. These apply ONLY to the LOCAL_LLM_* option.
LOCAL_LLM_TIMEOUT_SECONDS=300
LOCAL_LLM_MAX_OUTPUT_TOKENS=250
# Retrying a slow local generation just restarts it; 1 keeps failures fast.
LOCAL_LLM_MAX_RETRIES=1
# Prompt-size caps for the local lane: fewer, shorter sources cut CPU prompt
# evaluation (the dominant cost on this machine).
LOCAL_LLM_SOURCE_LIMIT=3
LOCAL_LLM_SOURCE_CHARS=800
# P0-6: max concurrent local-lane generations (1..16). Extra requests queue.
LOCAL_LLM_MAX_CONCURRENCY=2
# Optional remote-compatible provider settings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# T0-06: provider failover chain — comma-separated provider names in fallback
# order (openrouter,gemini,ollama; "auto" is not a chain entry). Empty = the
# current single-provider behavior (no wrapper). Only >=2 valid names activate
# the failover client; unknown names are logged and skipped.
LLM_FAILOVER_CHAIN=
# Circuit breaker bounds per provider in the failover chain.
LLM_CIRCUIT_MAX_FAILURES=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
# T0-07: API-key auth + rate limits for the /api/v1 surface (all default off —
# the anonymous demo never sends keys and is never limited).
# Require a valid API key on every /api/v1/* request (server-to-server
# credential; separate from Supabase user auth). false = open v1 surface.
API_KEY_ENABLED=false
# Comma-separated literal API keys accepted on /api/v1/* (env-only store for
# now; the SQLite key store is a documented follow-up). Never commit real keys.
API_KEYS=
# Sliding-window cap per key (and per anonymous IP when enabled below) on
# /api/v1/* requests per minute. 0 disables the limiter entirely.
RATE_LIMIT_PER_MINUTE=60
# Also rate-limit anonymous (no-key) requests per client IP on /api/v1/*.
# false = anonymous traffic is never limited (demo-identical).
RATE_LIMIT_ANON_ENABLED=false
# Path to the GGUF file (if using llama.cpp directly instead of Ollama)
GGUF_PATH=backend/ml_assets/gemma/model.gguf

# FastAPI settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS origin for frontend dev
FRONTEND_ORIGIN=http://localhost:3000
# Environment label surfaced in /readyz + startup logs (development|production)
ENVIRONMENT=development
# P0-5: expose /docs, /redoc, /openapi.json. false hides the API surface.
DOCS_ENABLED=true
# P0-1: /readyz returns 503 when a check fails (strict) or always 200 (default)
READINESS_STRICT=false

# RAG retrieval
RETRIEVAL_TOP_K=5
# FAISS or Chroma
RAG_BACKEND=FAISS
# Force BM25-only retrieval (skip the dense FAISS/OpenRouter channel).
# Useful for fully offline demos; default false.
RETRIEVAL_BM25_ONLY=false
# P0-7: corpus generation tag baked into demo-cache keys. Bump after an index
# rebuild so cached demo answers are never replayed against a new knowledge base.
CORPUS_VERSION=2026-08
# P0-4: overrides for the bundled ML assets / soil release folders (absolute
# paths). Leave blank to use the repo-relative defaults.
ML_ASSETS_DIR=
SOIL_RELEASE_DIR=
# F1-02: corpus-derived registered-dose reference for the verifier's
# gross-outlier flag. Leave blank for the default derived artifact; a missing
# file disables the check with a warning.
DOSE_REFERENCE_PATH=
# Flag a dosage claim only above referenced_band_max x this factor.
DOSE_OUTLIER_FACTOR=3.0
# R2: structured fact base for T1/T2 zero-LLM answers (offline-built by
# scripts/build_fact_base.py). Leave blank for the default derived artifact;
# a missing file returns an empty FactBase (T3 path is unaffected).
FACT_BASE_PATH=
# R4: structured resolver (0-LLM answers for potato late blight).
# Default false (dark launch); set true to enable T1/T2 resolution.
STRUCTURED_RESOLVER_ENABLED=false
STRUCTURED_RESOLVER_MIN_CONFIDENCE=0.85
# R7: model pricing table path and budget guard settings (default false)
MODEL_PRICES_PATH=
BUDGET_GUARD_ENABLED=false
PER_REQUEST_COST_CEILING_USD=0.05
DAILY_COST_CEILING_USD=10.0
# R6: modular capability routing seam (default false)
CAPABILITY_ROUTING_ENABLED=false
# PR1: operator-maintained late-blight weather snapshot (offline JSON, never
# fetched live). Leave blank for the default artifact; missing file disables
# the risk payload (clear message, never an error).
WEATHER_SNAPSHOT_PATH=

# P2: data-driven crop-stage calendars (offline-built by
# scripts/build_crop_calendars.py). Blank = default artifact
# (backend/ml_assets/agronomy/crop_calendars_v1.json); missing file disables
# stage computation (honest "unavailable", never an error).
CROP_CALENDARS_PATH=

# Local audit/session controls
AUDIT_LOG_PATH=backend/app/logs/safety_audit.jsonl
# Shared SQLite DB for the storage foundation (future audit/sessions adapters)
SQLITE_DB_PATH=backend/data/krishokchat.db
# T1-04: retention window (days) for audit records; 0 = keep forever (default off).
# Set 90 to enforce the 90-day PDP-aligned window (docs/production_readiness/retention_policy.md).
AUDIT_RETENTION_DAYS=0
# T1-04: session retention (days) for the SQLite session store; 0 = keep forever.
SESSION_RETENTION_DAYS=30
# T1-04: write-time PII redaction for stored audit query text; false = verbatim.
PII_REDACTION_ENABLED=false
# T0-02: audit backend — jsonl (default) | sqlite (same records in the shared SQLite DB)
AUDIT_BACKEND=jsonl
# T0-04: request-ID header name echoed by the request-ID middleware (default X-Request-ID)
REQUEST_ID_HEADER=X-Request-ID
# T0-04: log level for the krishokchat JSON logger (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
SESSION_MAX_TURNS=10
SESSION_TTL_SECONDS=1800
SESSION_BACKEND=memory  # memory | sqlite (adapter selected at container build time)

# Vision confidence and upload guardrails
VISION_CROP_CONFIDENCE_THRESHOLD=0.60
VISION_DISEASE_CONFIDENCE_THRESHOLD=0.55
VISION_MAX_IMAGE_BYTES=10000000

# ===== Voice (read-aloud TTS + optional ASR) =====
# TTS voice used by POST /api/tts when the request omits "voice".
# Valid: bn-BD-NabanitaNeural (female), bn-BD-PradeepNeural (male).
TTS_DEFAULT_VOICE=bn-BD-NabanitaNeural
# Per-request TTS timeout, in-memory audio cache cap, and spacing between
# startup prewarm calls (avoid hammering the Azure endpoint on boot).
TTS_TIMEOUT_SECONDS=15
TTS_CACHE_MAX_ENTRIES=256
TTS_PREWARM_SPACING_SECONDS=10
# Optional: Groq API key (free tier) to enable POST /api/transcribe.
# Leave empty to keep server-side transcription disabled (501).
GROQ_API_KEY=
# Whisper model used by POST /api/transcribe when a key is set.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# P0-4: cooldown between Gemini key switches during 429 retries (seconds).
GEMINI_KEY_COOLDOWN_SECONDS=6

# ===== Frontend =====
# Backend API URL (consumed by Next.js server components)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ===== OpenCode Provider (optional, dev machine only) =====
# API key for the agentrouter provider in opencode.json (https://agentrouter.org/console/token).
# Free credit covers only: claude-opus-4-8, claude-opus-5, gpt-5.6-sol.
AGENTROUTER_API_KEY=

# ===== Demo Mode =====
# Set to true to use cached responses for curated demo inputs
DEMO_MODE=true
# Path to cached demo responses
DEMO_CACHE_PATH=demo-assets/cached_responses.json
# Max entries kept in the demo answer cache (exact-replay of verified answers)
DEMO_CACHE_MAX_ENTRIES=100
# A1: rewrite follow-up queries into standalone retrieval queries (history-aware)
QUERY_REWRITE_ENABLED=true

# ===== Supabase Auth =====
# Project URL; same value as NEXT_PUBLIC_SUPABASE_URL. Backend uses this for JWKS verification.
SUPABASE_URL=
# Project ref (from https://<ref>.supabase.co). Defines the auth cookie name (sb-<ref>-auth-token).
SUPABASE_PROJECT_REF=
# Backend-only secret (service role). Never import from frontend code.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_...). Public; backend integration tests use
# it to mint a real token for JWKS verification tests. Same value as
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Google OAuth credentials (archived for deployment; Supabase dashboard holds
# the live provider config). Client ID is public; SECRET must never ship to
# the browser or source control.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: JWT signing secret (dashboard > Settings > API). Fallback to JWKS verification.
SUPABASE_JWT_SECRET=
# Publishable key (sb_publishable_...). Replaces the deprecated anon key; safe for the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only after the Google provider is enabled in the Supabase dashboard
# and a Google Cloud OAuth app is configured (amendment 15, P2).
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ===== Test Account (auto test login) =====
# Consumed by tools/ops/supabase_test_user.ps1; pre-created test user for local/hosted testing.
TEST_USER_EMAIL=test@krishokchat.com
TEST_USER_PASSWORD=change-me-8-chars-min

# ===== Test personas: free / premium / admin (amendment 02) =====
# Provisioned by tools/ops/supabase_test_user.ps1 -Personas. Throwaway accounts
# ONLY — never reuse real credentials here. The premium/admin labels are set on
# the profiles table by the same script (plan/role columns, migration 002).
TEST_FREE_USER_EMAIL=test-free@krishokchat.com
TEST_FREE_USER_PASSWORD=change-me-free-8
TEST_PREMIUM_USER_EMAIL=test-premium@krishokchat.com
TEST_PREMIUM_USER_PASSWORD=change-me-prem-8
TEST_ADMIN_USER_EMAIL=test-admin@krishokchat.com
TEST_ADMIN_USER_PASSWORD=change-me-admin-8

# ===== Dev-only test-user switcher (amendment 02 §6) =====
# NEVER set to true in production. When true, /auth renders one-click buttons
# for the three test personas above (frontend/.env.local mirrors the
# NEXT_PUBLIC_TEST_* values below).
NEXT_PUBLIC_DEV_USER_SWITCHER=false
NEXT_PUBLIC_TEST_FREE_USER_EMAIL=
NEXT_PUBLIC_TEST_FREE_USER_PASSWORD=
NEXT_PUBLIC_TEST_PREMIUM_USER_EMAIL=
NEXT_PUBLIC_TEST_PREMIUM_USER_PASSWORD=
NEXT_PUBLIC_TEST_ADMIN_USER_EMAIL=
NEXT_PUBLIC_TEST_ADMIN_USER_PASSWORD=

# ===== In-app notifications (amendment 02) =====
# How often the navbar bell refreshes (seconds). Offline-tolerant; failed
# fetches keep the previous state and never block the page.
NEXT_PUBLIC_NOTIFICATIONS_POLL_SECONDS=180

# ===== Live E2E smoke tests (optional, never in CI) =====
# Set to 1 to run backend/tests/test_smoke_live_e2e.py against a running
# backend with a live LLM provider (default base URL: http://127.0.0.1:8000).
RUN_LIVE_E2E=

