# ===== Backend =====
# Ollama server URL (default local install)
OLLAMA_BASE_URL=http://localhost:11434
# Name of the fine-tuned Gemma model loaded in Ollama
OLLAMA_MODEL_NAME=gemma-finetuned:4-bit
# Path to the GGUF file (if using llama.cpp directly instead of Ollama)
GGUF_PATH=backend/ml_assets/gemma/model.gguf

# FastAPI settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS origin for frontend dev
FRONTEND_ORIGIN=http://localhost:3000

# RAG retrieval
RETRIEVAL_TOP_K=5
# FAISS or Chroma
RAG_BACKEND=FAISS

# ===== Frontend =====
# Backend API URL (consumed by Next.js server components)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ===== Demo Mode =====
# Set to true to use cached responses for curated demo inputs
DEMO_MODE=true
# Path to cached demo responses
DEMO_CACHE_PATH=demo-assets/cached_responses.json
