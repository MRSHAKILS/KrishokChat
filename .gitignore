# ==============================================================================
# KrishokChat Advisory System — Production & Research Repository .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (STRICT — NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.p12
*.pfx
credentials.json
client_secrets.json
service_account.json

# ------------------------------------------------------------------------------
# 2. Package Managers & Dependencies
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 3. Python Runtime, Build & Distribution
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll
dist/
build/
*.egg-info/
*.egg

# ------------------------------------------------------------------------------
# 4. Next.js, Frontend Build & TypeScript
# ------------------------------------------------------------------------------
.next/
out/
*.tsbuildinfo
next-env.d.ts
.turbo/
.vercel

# ------------------------------------------------------------------------------
# 5. Logs, Databases & Runtime Storage
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

backend/data/
backend/app/logs/*
!backend/app/logs/.gitkeep
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 6. ML Assets, Training Checkpoints & Heavy Binary Archives (>100MB)
# ------------------------------------------------------------------------------
# Heavy raw training weights and checkpoints
backend/ml_assets/yolo/*.pt
backend/ml_assets/yolo/*.onnx
backend/ml_assets/classifier/*.pt
backend/ml_assets/classifier/*.onnx
backend/ml_assets/classifier/*.h5
backend/ml_assets/classifier/*.pkl
backend/ml_assets/gemma/*.gguf
backend/ml_assets/gemma/*.safetensors
backend/ml_assets/gemma/raw/
backend/ml_assets/rag_index/*.faiss
backend/ml_assets/rag_index/*.index
backend/ml_assets/rag_index/*.pkl
backend/ml_assets/rag_index/*.json

# Research retraining archives (multi-hundred MB training zip bundles)
backend/ml_assets/updated retrain/**/*.zip
backend/ml_assets/updated retrain/**/x/
experiments/results/**/chilli_weights_cache/
experiments/temp_*/
*.zip
*.tar
*.tar.gz
*.tgz

# Preserve directory structure
!backend/ml_assets/**/.gitkeep

# ------------------------------------------------------------------------------
# 7. LaTeX Build Artifacts (Keep .tex, .bib, .sty, figures, and compiled .pdf)
# ------------------------------------------------------------------------------
*.aux
*.dvi
*.out
*.nav
*.snm
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.lof
*.lot
*.lol
*.idx
*.ilg
*.ind
*.abs
page_screenshots/

# ------------------------------------------------------------------------------
# 8. Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage/
.mypy_cache/
.ruff_cache/
.eslintcache

# ------------------------------------------------------------------------------
# 9. Operating System & IDE Intermediates
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.zcode/

# ------------------------------------------------------------------------------
# 10. Dataset Workspace Intermediates (Multi-GB Raw/Intermediate Copies)
# ------------------------------------------------------------------------------
dataset_release/soil-moisture-detection/dataset/raw/
dataset_release/soil-moisture-detection/dataset/clean/
dataset_release/soil-moisture-detection/dataset/updated_dataset/
dataset_release/soil-moisture-detection/dataset/experiments/
