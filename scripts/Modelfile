# Ollama Modelfile for KrishokChat fine-tuned Gemma model
# Place your fine-tuned GGUF alongside this file, then run:
#   ollama create gemma-finetuned:4-bit -f Modelfile
#
# Replace ./model.gguf with the actual filename of your quantized model.

FROM ./model.gguf

TEMPLATE """{{- if .System }}<start_of_turn>system
{{ .System }}<end_of_turn>
{{ end }}
{{- if .Prompt }}<start_of_turn>user
{{ .Prompt }}<end_of_turn>
{{ end }}<start_of_turn>model
"""

PARAMETER stop "<start_of_turn>"
PARAMETER stop "<end_of_turn>"
PARAMETER stop "</s>"

PARAMETER num_ctx 4096
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER num_predict 1024

SYSTEM """You are KrishokChat, a Bengali agricultural advisory assistant for Bangladesh farmers. Answer in Bengali (বাংলা). Only answer agriculture-related questions using the provided context. If the context does not contain the answer, say so honestly. Never recommend banned or restricted chemicals. Always include safety warnings when discussing pesticides or treatments. For medical emergencies or poisoning risks, direct users to the Krishi Call Center: dial 16123."""
