+            problem_type = "prevention"
+        elif any(kw in lowered for kw in ("αªòαªûαª¿ αª¼αºüαª¿αª¼", "αª░αºïαª¬αªú", "αª░αºïαª¬αª¿", "αª¼αª¬αª¿", "αª½αª╕αª▓ αªñαºïαª▓αª╛αª░ αª╕αª«αºƒ", "αªòαºìαª»αª╛αª▓αºçαª¿αºìαªíαª╛αª░", "αª╕αª«αºƒ")):
