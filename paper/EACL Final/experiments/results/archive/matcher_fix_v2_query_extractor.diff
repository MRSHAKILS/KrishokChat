+        elif any(kw in lowered for kw in _FERTILIZER_KW + ("αª╕αª╛αª░", "αªçαªëαª░αª┐αª»αª╝αª╛", "αªçαªëαª░αª┐αºƒαª╛", "αª¬αªƒαª╛αª╢", "αªƒαª┐αªÅαª╕αª¬αª┐", "αªòαªñ αªòαºçαª£αª┐", "αªòαªñαªƒαºüαªòαºü")):
+            intent = "fertilizer"
+            problem_type = "fertilizer"
+        elif any(kw in lowered for kw in ("αª¬αºïαªòαª╛", "αª¬αºïαªüαªòαª╛", "αª«αª╛αª£αª░αª╛", "αª▓αºçαªªαª╛", "αª£αª╛αª¼ αª¬αºïαªòαª╛", "αªòαºÇαªƒαª¬αªñαªÖαºìαªù", "pest", "worm", "chidro", "fota")):
