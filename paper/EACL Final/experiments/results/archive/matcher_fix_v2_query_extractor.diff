+            problem_type = "management"
+        elif any(kw in lowered for kw in ("αª¬αª╛αª¿αª┐ αªªαª┐αª¼", "αª╕αºçαªÜ", "αª¬αª╛αª¿αª┐ αªªαºçαªôαºƒαª╛", "αªíαºìαª░αºçαª¿αºçαª£", "αª¬αª╛αª¿αª┐ αª¿αª┐αª╖αºìαªòαª╛αª╢αª¿", "irrigation", "αªíαºìαª░αºçαª¿")):
+            intent = "irrigation"
+            problem_type = "irrigation"
+        elif any(kw in lowered for kw in ("αª▓αªòαºìαª╖αªú", "αªªαª╛αªù", "αª░αºïαªùαºçαª░ αª¿αª╛αª«", "αªòαª┐ αª░αºïαªù", "αªòαºÇ αª░αºïαªù", "diagnosis")):
+            intent = "disease_identification"
+            problem_type = "disease"
+
+
+        # 7. Symptom token extraction
+        symptom_kws = (
+            "αª¼αª╛αªªαª╛αª«αª┐ αªªαª╛αªù", "αªòαª╛αª▓αºï αªªαª╛αªù", "αª╣αª▓αºüαªª αªªαª╛αªù", "αªùαºïαª▓ αªªαª╛αªù", "αª¢αª┐αªƒαª╛ αªªαª╛αªù", "αª¬αºüαªçαº£αª╛ αªùαºçαª¢αºç",
+            "αª¬αºïαº£αª╛ αªªαª╛αªù", "αª«αªçαª░αª╛ αª»αª╛αºƒ", "αªóαª▓αºç αª¬αº£αª╛", "αªòαºüαªüαªòαº£αª╛αºƒ", "αª¬αª╛αªñαª╛ αª╣αª▓αºüαªª", "αªùαª╛αª¢ αª╣αª▓αºüαªª",
+            "αªíαªùαª╛ αª¬αªÜαª╛", "αª½αª▓ αª¬αªÜαª╛", "αªùαºïαº£αª╛ αª¬αªÜαª¿", "αª╢αª┐αªòαº£ αª¬αªÜαª╛", "αªåαªáαª╛ αª¥αª░αª╛",
