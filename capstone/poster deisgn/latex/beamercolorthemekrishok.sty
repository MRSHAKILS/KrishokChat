% ============================================================
% KrishokChat poster colour theme  —  white + green
% Drop-in replacement for beamercolorthemecam.sty
% Palette derived from the product design system (Krishi Patrak)
% frontend/src/app/globals.css
% ============================================================

% ---------- Palette (the ONLY colours on the poster) ----------
\definecolor{leaf}{HTML}{2F5D3A}   % primary green   — block titles, rules
\definecolor{leaflight}{HTML}{EDF3EE} % pale green   — table fills, alert body
\definecolor{ink}{HTML}{1A1611}    % body text
\definecolor{ochre}{HTML}{C8893C}  % accent, sparing — "ours" highlight only
\definecolor{clay}{HTML}{A8542B}   % safety branch ONLY — 16123 / 999
\definecolor{rulegrey}{HTML}{DCE5DE}
\definecolor{papertint}{HTML}{F8F6F1}

% ---------- Basic ----------
\setbeamercolor{palette primary}{fg=ink,bg=white}
\setbeamercolor{palette secondary}{fg=ink,bg=white}
\setbeamercolor{palette tertiary}{fg=white,bg=leaf}
\setbeamercolor{palette quaternary}{fg=ink,bg=white}
\setbeamercolor{structure}{fg=leaf}

% ---------- Headline: white background, green rule ----------
\setbeamercolor{headline}{fg=ink,bg=white}
\setbeamercolor{headline title}{fg=ink}
\setbeamercolor{headline author}{fg=ink}
\setbeamercolor{headline institute}{fg=leaf}
\setbeamercolor{headline rule}{bg=leaf}

% ---------- Block: the standard panel ----------
\setbeamercolor{block title}{fg=leaf,bg=white}
\setbeamercolor{block separator}{bg=leaf}
\setbeamercolor{block body}{fg=ink,bg=white}

% ---------- Alert block: the evidence / safety panels ----------
\setbeamercolor{block alerted title}{fg=leaf,bg=leaflight}
\setbeamercolor{block alerted separator}{bg=leaf}
\setbeamercolor{block alerted body}{fg=ink,bg=leaflight}

% ---------- Example block: business / roadmap ----------
\setbeamercolor{block example title}{fg=leaf,bg=papertint}
\setbeamercolor{block example separator}{bg=ochre}
\setbeamercolor{block example body}{fg=ink,bg=papertint}

% ---------- Misc ----------
\setbeamercolor{heading}{fg=ink}
\setbeamercolor{item}{fg=leaf}
\setbeamercolor{caption}{fg=ink}
\setbeamercolor{caption name}{fg=leaf}
