% ============================================================
% KrishokChat poster colour theme
% Palette taken from the product design system (Krishi Patrak),
% frontend/src/app/globals.css — so poster and product read as one identity.
% ============================================================

% ---------- Palette (the ONLY colours on the poster) ----------
\definecolor{paper}{HTML}{FAF6EF}     % page canvas — warm off-white
\definecolor{paperII}{HTML}{F2EBDC}   % secondary card fill
\definecolor{bone}{HTML}{E7DFD0}      % rules, borders
\definecolor{ink}{HTML}{1A1611}       % body text
\definecolor{leaf}{HTML}{2F5D3A}      % primary green — titles, rules, bars
\definecolor{leaflight}{HTML}{E8F0EA} % pale green — evidence card
\definecolor{ochre}{HTML}{C8893C}     % accent — "ours" rows, partial marks
\definecolor{ochretint}{HTML}{F5E7D2} % accent fill for highlighted rows
\definecolor{clay}{HTML}{A8542B}      % safety ONLY — 16123 / 999
\definecolor{rulegrey}{HTML}{D8D0C0}

% ---------- Canvas ----------
\setbeamercolor{background canvas}{bg=paper}

% ---------- Basic ----------
\setbeamercolor{palette primary}{fg=ink,bg=paper}
\setbeamercolor{palette secondary}{fg=ink,bg=paper}
\setbeamercolor{palette tertiary}{fg=paper,bg=leaf}
\setbeamercolor{palette quaternary}{fg=ink,bg=paper}
\setbeamercolor{structure}{fg=leaf}

% ---------- Headline: white band, lifted off the paper canvas ----------
\setbeamercolor{headline}{fg=ink,bg=white}
\setbeamercolor{headline title}{fg=ink}
\setbeamercolor{headline author}{fg=ink}
\setbeamercolor{headline institute}{fg=leaf}
\setbeamercolor{headline rule}{bg=leaf}

% ---------- Block: rule-separated, no box (the gemini idiom) ----------
\setbeamercolor{block title}{fg=leaf,bg=paper}
\setbeamercolor{block separator}{bg=leaf}
\setbeamercolor{block body}{fg=ink,bg=paper}

% ---------- Alert block: the evidence card ----------
\setbeamercolor{block alerted title}{fg=leaf,bg=leaflight}
\setbeamercolor{block alerted separator}{bg=leaf}
\setbeamercolor{block alerted body}{fg=ink,bg=leaflight}

% ---------- Example block: business / secondary card ----------
\setbeamercolor{block example title}{fg=leaf,bg=paperII}
\setbeamercolor{block example separator}{bg=ochre}
\setbeamercolor{block example body}{fg=ink,bg=paperII}

% ---------- Misc ----------
\setbeamercolor{heading}{fg=ink}
\setbeamercolor{item}{fg=leaf}
\setbeamercolor{caption}{fg=ink}
\setbeamercolor{caption name}{fg=leaf}
