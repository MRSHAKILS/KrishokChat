root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,pyi}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,css,scss,html,md,yml,yaml}]
indent_size = 2

[*.{ps1,bat,sh}]
indent_size = 2
# PowerShell uses CRLF on Windows but we enforce LF in repo; .gitattributes handles conversion.

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
